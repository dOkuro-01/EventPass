# Copia este archivo a .env y conserva la contraseña si ya existe el volumen MySQL.
MYSQL_ROOT_PASSWORD=replace-with-the-existing-or-a-strong-password

# Datos de la cola creada en us-east-1.
AWS_REGION=us-east-1
PEDIDOS_QUEUE_URL=

# Genera un secreto aleatorio de al menos 32 caracteres y úsalo también en Lambda.
INTERNAL_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
