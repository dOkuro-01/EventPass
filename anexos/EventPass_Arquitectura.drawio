<mxfile host="app.diagrams.net" modified="2026-08-30T12:35:00.000Z" agent="5.0" version="21.0.0" type="device">
  <diagram id="eventpass-perfect-spacing" name="Arquitectura 100% Despejada">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITULO -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size: 19px; color: #0F172A;&quot;&gt;Arquitectura de Microservicios y Procesamiento Serverless &amp;mdash; EventPass&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px; color: #475569;&quot;&gt;JVY0101: Solución Nativa en Nube (Control de Acceso, Microservicios desacoplados, SQS y AWS Lambda)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="800" height="50" as="geometry" />
        </mxCell>

        <!-- COLUMNA 1: CLIENTES (x=40, w=180) -->
        <mxCell id="box_clients" value="Clientes / Roles" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontStyle=1;fontSize=13;startSize=28;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="180" height="780" as="geometry" />
        </mxCell>
        <mxCell id="client_buyer" value="&lt;b style=&quot;font-size: 13px; color: #0284C7;&quot;&gt;Comprador&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px; color: #64748B;&quot;&gt;(Web / Mobile App)&lt;/i&gt;&lt;hr style=&quot;margin: 6px 0; border: 0.5px solid #CBD5E1;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 11px; color: #334155; line-height: 1.4;&quot;&gt;• Consulta eventos&lt;br&gt;• Realiza compras&lt;br&gt;• Consulta tickets QR&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=1.5;arcSize=6;" vertex="1" parent="box_clients">
          <mxGeometry x="15" y="70" width="150" height="130" as="geometry" />
        </mxCell>
        <mxCell id="client_staff" value="&lt;b style=&quot;font-size: 13px; color: #EA580C;&quot;&gt;Staff de Puerta&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px; color: #64748B;&quot;&gt;(App de Control)&lt;/i&gt;&lt;hr style=&quot;margin: 6px 0; border: 0.5px solid #CBD5E1;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 11px; color: #334155; line-height: 1.4;&quot;&gt;• Valida código acceso&lt;br&gt;• Registra utilización&lt;br&gt;• Evita reuso de ticket&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;arcSize=6;" vertex="1" parent="box_clients">
          <mxGeometry x="15" y="560" width="150" height="130" as="geometry" />
        </mxCell>

        <!-- COLUMNA 2: API GATEWAY (x=280, w=170) -->
        <mxCell id="card_apigw" value="&lt;div style=&quot;text-align: center; margin-top: 15px;&quot;&gt;&lt;b style=&quot;font-size: 15px; color: #FFFFFF;&quot;&gt;Amazon API Gateway&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px; color: #E0F2FE;&quot;&gt;Punto Único de Entrada Seguro&lt;/i&gt;&lt;/div&gt;&lt;hr style=&quot;margin: 15px 0; border: 0.5px solid #38BDF8;&quot;&gt;&lt;div style=&quot;text-align: left; font-size: 11px; color: #F8FAFC; line-height: 1.6; padding-left: 6px;&quot;&gt;• Enrutamiento a Microservicios&lt;br&gt;• Autenticación &amp;amp; Roles (JWT)&lt;br&gt;• Control de Tráfico / Throttling&lt;br&gt;• Terminación SSL / TLS&lt;br&gt;• Aislamiento perimetral VPC&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="280" y="90" width="170" height="780" as="geometry" />
        </mxCell>

        <!-- COLUMNA 3: MICROSERVICIOS CORE (x=530, w=470) -->
        <mxCell id="box_ms" value="Zona de Microservicios (Backend Java / Spring Boot)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontStyle=1;fontSize=13;startSize=28;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="530" y="90" width="470" height="780" as="geometry" />
        </mxCell>

        <!-- MS 1: Auth -->
        <mxCell id="ms_auth" value="&lt;b style=&quot;font-size: 12px; color: #4338CA;&quot;&gt;Microservicio Autenticación y Usuarios&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10.5px; color: #475569; text-align: left; margin-top: 4px;&quot;&gt;• Registro e inicio de sesión&lt;br&gt;• Generación y validación de Tokens JWT&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.5;arcSize=6;" vertex="1" parent="box_ms">
          <mxGeometry x="20" y="55" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="db_auth" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;DB Usuarios&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#E0E7FF;strokeColor=#4338CA;" vertex="1" parent="box_ms">
          <mxGeometry x="325" y="57.5" width="115" height="70" as="geometry" />
        </mxCell>

        <!-- MS 2: Eventos -->
        <mxCell id="ms_events" value="&lt;b style=&quot;font-size: 12px; color: #047857;&quot;&gt;Microservicio Eventos&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10.5px; color: #475569; text-align: left; margin-top: 4px;&quot;&gt;• Catálogo de Eventos universitarios&lt;br&gt;• Control &amp;amp; Descuento Atómico de Aforo&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.5;arcSize=6;" vertex="1" parent="box_ms">
          <mxGeometry x="20" y="220" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="db_events" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;DB Eventos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;(Aforos)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#D1FAE5;strokeColor=#047857;" vertex="1" parent="box_ms">
          <mxGeometry x="325" y="222.5" width="115" height="70" as="geometry" />
        </mxCell>

        <!-- MS 3: Ordenes -->
        <mxCell id="ms_orders" value="&lt;b style=&quot;font-size: 12px; color: #B45309;&quot;&gt;Microservicio Órdenes&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10.5px; color: #475569; text-align: left; margin-top: 4px;&quot;&gt;• Recepción de compras sin bloqueo&lt;br&gt;• Estado: Aceptada / Pendiente de emisión&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;arcSize=6;" vertex="1" parent="box_ms">
          <mxGeometry x="20" y="390" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="db_orders" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;DB Órdenes&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FEF3C7;strokeColor=#B45309;" vertex="1" parent="box_ms">
          <mxGeometry x="325" y="392.5" width="115" height="70" as="geometry" />
        </mxCell>

        <!-- MS 4: Tickets -->
        <mxCell id="ms_tickets" value="&lt;b style=&quot;font-size: 12px; color: #0F766E;&quot;&gt;Microservicio Tickets&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size: 10.5px; color: #475569; text-align: left; margin-top: 4px;&quot;&gt;• Generación de código único de acceso&lt;br&gt;• Consulta de tickets emitidos&lt;br&gt;• Validación &amp;amp; Canje en puerta&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;arcSize=6;" vertex="1" parent="box_ms">
          <mxGeometry x="20" y="590" width="260" height="85" as="geometry" />
        </mxCell>
        <mxCell id="db_tickets" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;DB Tickets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9.5px; color: #475569;&quot;&gt;(Códigos)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#CCFBF1;strokeColor=#0F766E;" vertex="1" parent="box_ms">
          <mxGeometry x="325" y="597.5" width="115" height="70" as="geometry" />
        </mxCell>

        <!-- Conexiones internas MS -> DBs -->
        <mxCell id="edge_ms1_db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4338CA;strokeWidth=1.5;" edge="1" parent="box_ms" source="ms_auth" target="db_auth" />
        <mxCell id="edge_ms2_db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#047857;strokeWidth=1.5;" edge="1" parent="box_ms" source="ms_events" target="db_events" />
        <mxCell id="edge_ms3_db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B45309;strokeWidth=1.5;" edge="1" parent="box_ms" source="ms_orders" target="db_orders" />
        <mxCell id="edge_ms4_db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0F766E;strokeWidth=1.5;" edge="1" parent="box_ms" source="ms_tickets" target="db_tickets" />

        <!-- COLUMNA 4: SERVERLESS (x=1080, w=480) -->
        <mxCell id="box_serverless" value="Procesamiento Asíncrono Serverless (Emisión)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#0F172A;fontStyle=1;fontSize=13;startSize=28;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1080" y="90" width="480" height="780" as="geometry" />
        </mxCell>

        <mxCell id="card_sqs" value="&lt;b style=&quot;font-size: 13px; color: #C2410C;&quot;&gt;Amazon SQS&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px; color: #9A3412;&quot;&gt;Cola: orders-to-process&lt;/i&gt;&lt;hr style=&quot;margin: 6px 0; border: 0.5px solid #FFEDD5;&quot;&gt;&lt;div style=&quot;font-size: 11px; color: #431407; text-align: left; line-height: 1.4;&quot;&gt;• Amortigua ráfagas de compras masivas en preventa&lt;br&gt;• Desacopla la orden de compra del proceso de emisión&lt;/div&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;arcSize=4;" vertex="1" parent="box_serverless">
          <mxGeometry x="30" y="380" width="420" height="85" as="geometry" />
        </mxCell>

        <mxCell id="card_lambda" value="&lt;b style=&quot;font-size: 13px; color: #92400E;&quot;&gt;AWS Lambda Worker&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px; color: #78350F;&quot;&gt;(Orquestador de Emisión Serverless)&lt;/i&gt;&lt;hr style=&quot;margin: 6px 0; border: 0.5px solid #FEF3C7;&quot;&gt;&lt;div style=&quot;font-size: 11px; color: #451A03; text-align: left; line-height: 1.5;&quot;&gt;1. Desencola la orden pendiente desde SQS.&lt;br&gt;2. Verifica y descuenta aforo de forma atómica en &lt;b&gt;MS Eventos&lt;/b&gt;.&lt;br&gt;3. Si hay aforo disponible &amp;rarr; Solicita generar código en &lt;b&gt;MS Tickets&lt;/b&gt;.&lt;br&gt;4. Si el aforo se agotó &amp;rarr; Marca la orden como rechazada.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;arcSize=6;" vertex="1" parent="box_serverless">
          <mxGeometry x="30" y="555" width="420" height="150" as="geometry" />
        </mxCell>

        <mxCell id="edge_sqs_lambda" value="Trigger / Consumo Asíncrono" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=2;dashed=1;fontColor=#EA580C;fontSize=11;fontStyle=1;" edge="1" parent="box_serverless" source="card_sqs" target="card_lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CONECTORES CLIENTES -> API GATEWAY -->
        <mxCell id="edge_buyer_gw" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;fontColor=#0284C7;fontSize=11;fontStyle=1;" edge="1" parent="1" source="client_buyer" target="card_apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_staff_gw" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=2;fontColor=#EA580C;fontSize=11;fontStyle=1;" edge="1" parent="1" source="client_staff" target="card_apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CONECTORES API GATEWAY -> MICROSERVICIOS -->
        <mxCell id="edge_gw_auth" value="/api/auth/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#4338CA;fontSize=11;fontStyle=1;exitX=1;exitY=0.075;entryX=0;entryY=0.5;" edge="1" parent="1" source="card_apigw" target="ms_auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_gw_events" value="/api/eventos/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#047857;strokeWidth=1.5;fontColor=#047857;fontSize=11;fontStyle=1;exitX=1;exitY=0.285;entryX=0;entryY=0.5;" edge="1" parent="1" source="card_apigw" target="ms_events">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_gw_orders" value="POST /api/ordenes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B45309;strokeWidth=2;fontColor=#B45309;fontSize=11;fontStyle=1;exitX=1;exitY=0.505;entryX=0;entryY=0.5;" edge="1" parent="1" source="card_apigw" target="ms_orders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_gw_tickets" value="/api/tickets/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#0F766E;fontSize=11;fontStyle=1;exitX=1;exitY=0.765;entryX=0;entryY=0.5;" edge="1" parent="1" source="card_apigw" target="ms_tickets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FLUJO ORDENES -> SQS -->
        <mxCell id="edge_orders_sqs" value="Publicar Orden" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=2;fontColor=#C2410C;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="db_orders" target="card_sqs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RETORNOS DE LAMBDA (CANAL LIBRE DERECHO x=1040) -->
        <mxCell id="edge_lambda_events" value="1. Verificar y Descontar Aforo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#047857;strokeWidth=2;fontColor=#047857;fontSize=11;fontStyle=1;exitX=0;exitY=0.25;entryX=1;entryY=0.5;" edge="1" parent="1" source="card_lambda" target="db_events">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1040" y="682" />
              <mxPoint x="1040" y="347.5" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="edge_lambda_tickets" value="2. Generar Ticket con Código" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0F766E;strokeWidth=2;fontColor=#0F766E;fontSize=11;fontStyle=1;exitX=0;exitY=0.75;entryX=1;entryY=0.5;" edge="1" parent="1" source="card_lambda" target="db_tickets">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1040" y="757" />
              <mxPoint x="1040" y="722.5" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
